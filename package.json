{
  "name": "treehole-diary",
  "version": "0.1.2",
  "description": "Obsidian plugin that imports encrypted diary emails over IMAP",
  "main": "main.js",
  "license": "MIT",
  "author": "chnyjg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chnyjg/Treehole-Diary.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
