  },
  "dependencies": {
    "imapflow": "^1.0.0",
    "mailparser": "^3.6.0"
  },
  "devDependencies": {
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.21.0",
    "obsidian": "^1.4.0",
